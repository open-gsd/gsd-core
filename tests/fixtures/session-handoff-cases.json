{
  "description": "Shared case table for the per-session handoff filename grammar and ownership rule (ADR-4962 Decisions 2 and 7). The store (src/session-store.cts) is the owner; every follower listed in `followers` is held to it by tests/session-handoff-parity.test.cjs, and the text contract handoff-grammar-readers-registered fails when a file that reads the grammar is not listed.",
  "followers": [
    {
      "id": "statusline",
      "file": "hooks/gsd-statusline.js",
      "why": "a hook cannot require the compiled CLI (#3582), so it carries an inline copy of the grammar"
    }
  ],
  "cases": [
    {
      "name": "latest slot, caller holds the role",
      "file": "HANDOFF.latest.coordinator.json",
      "body": {},
      "identity": {
        "session_id": "s1",
        "role_id": "coordinator"
      },
      "expect": {
        "kind": "latest",
        "role_id": "coordinator",
        "session_id": null,
        "is_self": true
      }
    },
    {
      "name": "latest slot, caller holds another role",
      "file": "HANDOFF.latest.coordinator.json",
      "body": {},
      "identity": {
        "session_id": "s1",
        "role_id": "implementer"
      },
      "expect": {
        "kind": "latest",
        "role_id": "coordinator",
        "session_id": null,
        "is_self": false
      }
    },
    {
      "name": "latest slot, caller has no role",
      "file": "HANDOFF.latest.coordinator.json",
      "body": {},
      "identity": {
        "session_id": "s1",
        "role_id": null
      },
      "expect": {
        "kind": "latest",
        "role_id": "coordinator",
        "session_id": null,
        "is_self": false
      }
    },
    {
      "name": "session-keyed, same session",
      "file": "HANDOFF.s1.json",
      "body": {},
      "identity": {
        "session_id": "s1",
        "role_id": null
      },
      "expect": {
        "kind": "session",
        "role_id": null,
        "session_id": "s1",
        "is_self": true
      }
    },
    {
      "name": "session-keyed, other session whose body names the caller's role (body role never owns a keyed file)",
      "file": "HANDOFF.s1.json",
      "body": {
        "role_id": "coordinator",
        "role": "coordinator"
      },
      "identity": {
        "session_id": "s2",
        "role_id": "coordinator"
      },
      "expect": {
        "kind": "session",
        "role_id": null,
        "session_id": "s1",
        "is_self": false
      }
    },
    {
      "name": "session id with dots is one session id",
      "file": "HANDOFF.a.b.c.json",
      "body": {},
      "identity": {
        "session_id": "a.b.c",
        "role_id": null
      },
      "expect": {
        "kind": "session",
        "role_id": null,
        "session_id": "a.b.c",
        "is_self": true
      }
    },
